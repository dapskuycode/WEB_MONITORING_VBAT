  "fixture_notice": "Semua ID, nilai, waktu, video_id dan kebijakan adalah fixture usulan, bukan data nyata, hasil runtime atau persetujuan LMS-01. Contoh independen; attempt_start mengasumsikan prerequisite telah terpenuhi.",
  "scope": "Pilot student dan admin. Tugas, grading manual, offline, billing dan upload mempunyai kontrak tambahan pada batch terkait; route ini bukan indeks lengkap seluruh FSD.",
  "namespace_proposal": "Path /lms memisahkan DTO target dari root legacy; perlu review T09 sebelum dibekukan.",
  "auth": {
    "student": "Bearer token; owner dari server",
    "admin": "Bearer token + kapabilitas admin LMS",
    "role_mapping": "super_admin/student/teknisi dipetakan berdasarkan kapabilitas existing; bukan menerima role baru dari client"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/lms/courses/my",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Kelas milik akun dan ringkasan progres"
    },
    {
      "method": "GET",
      "path": "/api/v1/lms/courses/{course_id}",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Detail kelas milik akun"
    },
    {
      "method": "GET",
      "path": "/api/v1/lms/courses/{course_id}/syllabus",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Modul dan urutan aktivitas materi/kuis"
    },
    {
      "method": "GET",
      "path": "/api/v1/lms/courses/{course_id}/progress",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Progres dan aktivitas berikutnya"
    },
    {
      "method": "POST",
      "path": "/api/v1/lms/materials/{material_id}/access",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Grant media pendek dan sesi playback"
    },
    {
      "method": "POST",
      "path": "/api/v1/lms/materials/{material_id}/progress-events",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Observasi playback; bukan keputusan completion"
    },
    {
      "method": "POST",
      "path": "/api/v1/lms/materials/{material_id}/completion",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Completion bacaan/link; video ditolak"
    },
    {
      "method": "GET",
      "path": "/api/v1/lms/quizzes/{quiz_id}",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Instruksi dan aturan kuis tanpa kunci"
    },
    {
      "method": "POST",
      "path": "/api/v1/lms/quizzes/{quiz_id}/attempts",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Buat atau lanjut attempt aktif"
    },
    {
      "method": "GET",
      "path": "/api/v1/lms/quiz-attempts/{attempt_id}",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Resume snapshot dan jawaban milik akun"
    },
    {
      "method": "PUT",
      "path": "/api/v1/lms/quiz-attempts/{attempt_id}/answers",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Autosave berurutan"
    },
    {
      "method": "POST",
      "path": "/api/v1/lms/quiz-attempts/{attempt_id}/submit",
      "scope": "authenticated_student_owner",
      "status": "planned",
      "purpose": "Finalisasi attempt idempotent"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/lms/courses",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Daftar kelas admin"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/courses",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Buat kelas Draft"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/lms/courses/{course_id}",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Edit kelas dengan revision"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/courses/{course_id}/modules",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Buat modul Draft"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/lms/modules/{module_id}",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Edit modul"
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/lms/courses/{course_id}/modules/order",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Urutkan seluruh modul dalam kelas"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/modules/{module_id}/materials",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Tambahkan materi Draft"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/lms/materials/{material_id}",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Edit materi canonical"
    },
    {
      "method": "PUT",
      "path": "/api/v1/admin/lms/modules/{module_id}/activities/order",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Urutkan aktivitas pada parent yang sama"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/courses/{course_id}/quizzes",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Buat kuis dengan penempatan per materi/modul/kelas"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/lms/quizzes/{quiz_id}",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Edit kuis/revisi dan penempatan"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/courses/{course_id}/preview-session",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Preview terisolasi dari progres siswa"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/admin/lms/courses/{course_id}/status",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Publish/archive setelah validasi"
    },
    {
      "method": "GET",
      "path": "/api/v1/admin/lms/imports/template",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Template dengan referensi kode canonical"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/imports/preview",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Validasi seluruh berkas tanpa menulis konten"
    },
    {
      "method": "POST",
      "path": "/api/v1/admin/lms/imports/{import_id}/apply",
      "scope": "authorized_lms_admin",
      "status": "planned",
      "purpose": "Terapkan hasil tervalidasi sebagai Draft"
    }
  ],
